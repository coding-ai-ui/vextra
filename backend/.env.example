# Generate a unique key, then copy it here. Never commit backend/.env.
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Used only by `manage.py create_admin`; never expose this value to the frontend.
ADMIN_EMAIL=talyn2007@gmail.com
ADMIN_INITIAL_PASSWORD=

# Fictional catalogue is labelled as demo content; false hides demo projects.
VEXTRA_DEMO_MODE=true
FRONTEND_URL=http://127.0.0.1:5173
# Local password reset emails are written to ignored artifacts/emails/.
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
DEFAULT_FROM_EMAIL=Vextra <accounts@vextra.local>
# For delivery outside a local demo, configure SMTP and change EMAIL_BACKEND to:
# django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
